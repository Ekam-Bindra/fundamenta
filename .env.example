# Copy to .env and fill in. Everything has a safe default for local dev.

# Storage: SQLite locally; a free managed Postgres URL in production.
DATABASE_URL=sqlite:///./data.db

# Protects /dashboard and admin endpoints. CHANGE THIS before deploying.
ADMIN_TOKEN=change-me

# Billing tiers
FREE_DAILY_LIMIT=100
PRO_DAILY_LIMIT=10000
PRO_PRICE_USD=29

# --- SEC EDGAR (data source) ---
# REQUIRED in production: SEC blocks anonymous bots. Use your real name + email.
SEC_USER_AGENT=Your Name your-email@example.com
# Comma-separated tickers to cover (used unless COVERAGE_FILE is set).
COVERAGE_TICKERS=AAPL,MSFT,GOOGL,AMZN,META,NVDA,TSLA,NFLX,AMD,INTC
# Set to cover the full S&P 500 (~503 tickers). Regenerate the file with
# `python -m scripts.refresh_sp500`. Note: a full run is slower and downloads a
# lot more from SEC than the 20-ticker default.
COVERAGE_FILE=
# e.g. COVERAGE_FILE=app/data/sp500.txt

# --- RapidAPI (marketplace billing) ---
# Set to the proxy secret RapidAPI gives you to enable the marketplace path.
RAPIDAPI_PROXY_SECRET=
RAPIDAPI_PAID_PLANS=PRO,ULTRA,MEGA,CUSTOM
# Set true to reject all direct (non-RapidAPI) traffic — locks billing to RapidAPI.
REQUIRE_RAPIDAPI=false

# --- Stripe (direct billing) ---
# Set to your webhook signing secret (whsec_...) to enable POST /webhooks/stripe.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
# Your Stripe Payment Link URL; when set, the /signup page shows an upgrade button.
STRIPE_PAYMENT_LINK=

# Set true to run the ingest loop inside the web process (single always-on host).
RUN_SCHEDULER=false
